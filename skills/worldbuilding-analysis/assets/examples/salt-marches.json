  "conceits": [
    {"id": "S1", "tier": "SYS", "domain": "D-tide", "role": "axiom", "force": "strict", "kind": "law",
     "text": "Spring tides flood all ground below the high-tide line once a fortnight; nothing unmaintained there survives a season.",
     "terms": ["spring tide", "high-tide line"]},
    {"id": "S2", "tier": "SYS", "domain": "D-pans", "role": "axiom", "force": "default", "kind": "law",
     "text": "A pan yields in proportion to crew labour and evaporation days; a pan below the high-tide line is rebuilt after each spring tide.",
     "terms": ["pan", "spring tide", "high-tide line"]},
    {"id": "S3", "tier": "SYS", "domain": "D-lords", "role": "axiom", "force": "default", "kind": "policy",
     "text": "Salt-lords levy each crystallization, not each pan or acre.",
     "table": "One measure in five; lowered one step after any season in which output falls by a fifth; restored after two full seasons."},
    {"id": "S4", "tier": "SYS", "domain": "D-oath", "role": "axiom", "force": "strict", "kind": "law",
     "text": "An oath sworn at slack water binds: salt worked by its breaker will not crystallize.",
     "terms": ["oath", "slack water", "crystallization"]},
    {"id": "S5", "tier": "SYS", "domain": "D-guild", "role": "axiom", "force": "tendency", "kind": "tendency",
     "text": "Oath-fellowships keep their collective oaths.",
     "norm": "Kept.", "deviation": "About one fellowship in twenty breaks within a decade.", "movers": "Famine doubles the rate."},
    {"id": "S6", "tier": "SYS", "domain": "D-guild", "role": "axiom", "force": "default", "kind": "law",
     "text": "Crews bound to one lord by slack-water contracts, in standing contact, form oath-fellowships.",
     "terms": ["oath-fellowship", "crew"]},
    {"id": "S7", "tier": "SYS", "domain": "D-deep", "role": "axiom", "force": "default", "kind": "law",
     "text": "Eels of the Deep Channel live three centuries."},
    {"id": "S8", "tier": "SYS", "domain": "D-oath", "role": "axiom", "force": "strict", "kind": "prohibition",
     "text": "A coerced oath does not bind. (Minted by Ledger entry C1.)", "terms": ["oath"]},
    {"id": "S9", "tier": "SYS", "domain": "D-pans", "role": "axiom", "force": "default", "kind": "law",
     "text": "Pans below the high-tide line are rebuilt twenty-six times a year."},

    {"id": "B1", "tier": "LORE", "domain": "D-pans", "role": "substrate",
