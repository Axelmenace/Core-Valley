    {"id": "L14", "tier": "LORE", "domain": "D-tide", "role": "substrate",
     "text": "The Marsh Tide: two spring tides a month over a three-yard range."},

    {"id": "L1", "tier": "LORE", "domain": "D-pans", "text": "The working year is a fortnightly round of rebuild and boil."},
    {"id": "L2", "tier": "LORE", "domain": "D-pans", "text": "Lords bind crews by slack-water delivery oaths; the contracts enforce themselves."},
    {"id": "L3", "tier": "LORE", "domain": "D-guild", "text": "The Pan Guild: oath-fellowships of crews that bargain with the lords as bodies."},
    {"id": "L4", "tier": "LORE", "domain": "D-pans", "text": "Each pan is worked by a crew of about six."},
    {"id": "L5", "tier": "LORE", "domain": "D-lords", "text": "House Venn has held the eastern estate for two centuries."},
    {"id": "L6", "tier": "LORE", "domain": "D-cult", "text": "The Marches hold a midsummer regatta."},
    {"id": "L7", "tier": "LORE", "domain": "D-cult", "stance": "lens:Tide Cult", "text": "The tide is the breath of a sleeping god."},
    {"id": "L8", "tier": "LORE", "domain": "D-cult", "text": "The Tide Cult teaches that the tide is a god's breath."},
    {"id": "L9", "tier": "LORE", "domain": "D-lords", "text": "The salt levy has held near one measure in five for two centuries."},
    {"id": "L10", "tier": "LORE", "domain": "D-lords", "text": "Lords keep Witnesses of Free Swearing at every slack-water stone."},
    {"id": "L11", "tier": "LORE", "domain": "D-pans", "status": "witness",
